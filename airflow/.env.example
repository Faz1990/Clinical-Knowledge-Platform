# Environment variables for local Airflow standalone (WSL).
# These are set by scripts/start_airflow.sh — you do not normally need to set them manually.
# Reference only; do not store real credentials here.

# SP credentials — clinical-platform-cicd (appId <sp-application-id>).
# Used by get_databricks_token() (dbt adapter) via MSAL client-credentials.
# Secret lives in Key Vault <key-vault-name> → databricks-cicd-sp-secret and in .env (gitignored).
AZURE_CLIENT_ID=<sp-application-id>
AZURE_CLIENT_SECRET=<sp-client-secret-from-key-vault>
AZURE_TENANT_ID=<azure-tenant-id>

# Databricks connection for DatabricksSubmitRunOperator (operator adapter).
# SP extra field names are provider-version-dependent — verify against installed
# apache-airflow-providers-databricks before setting in production.
# Likely format for providers 6.x+:
AIRFLOW_CONN_DATABRICKS_DEFAULT={"conn_type":"databricks","host":"<databricks-workspace-url>","extra":{"azure_tenant_id":"<tenant-id>","azure_client_id":"<sp-application-id>","azure_client_secret":"<sp-client-secret>"}}

AIRFLOW_HOME=~/airflow
