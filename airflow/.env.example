# Environment variables for local Airflow standalone (WSL).
# These are set by scripts/start_airflow.sh — you do not normally need to set them manually.
# Reference only; do not store a real token here.

# Short-lived AD token minted at Airflow startup.
# Prod-TODO (P6): replaced by SP client_secret via Airflow connection or Key Vault.
DATABRICKS_TOKEN=<az-minted-token-goes-here>

# Databricks connection for the DatabricksSubmitRunOperator — built from DATABRICKS_TOKEN.
# Stored in-process only; never written to the SQLite metadata DB.
# JSON format: Airflow resolves AIRFLOW_CONN_<ID> as a connection automatically.
AIRFLOW_CONN_DATABRICKS_DEFAULT={"conn_type":"databricks","host":"adb-7405614006245057.17.azuredatabricks.net","password":"<same-token>"}

AIRFLOW_HOME=~/airflow
