# Root .env.example — copy to .env and fill in values. Never commit .env.
# See airflow/.env.example for Airflow-specific variables.

# ── Azure SP (P1–P6, MSAL auth for dbt path) ─────────────────────────────────
AZURE_CLIENT_ID=<sp-application-id>
AZURE_CLIENT_SECRET=<sp-client-secret-from-key-vault>
AZURE_TENANT_ID=<azure-tenant-id>

# ── Databricks (P7 embedding pipeline — local dev PAT) ───────────────────────
# In CI/Airflow replace with MSAL client-credentials token (open item from P6).
DATABRICKS_HOST=<databricks-workspace-url>          # e.g. adb-xxxx.17.azuredatabricks.net
DATABRICKS_HTTP_PATH=<sql-warehouse-http-path>      # e.g. /sql/1.0/warehouses/xxxx
DATABRICKS_TOKEN=<personal-access-token>

# ── Azure OpenAI (P7+) ───────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
AZURE_OPENAI_KEY=<azure-openai-api-key>
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o

# ── pgvector / Docker Postgres (P7+) ─────────────────────────────────────────
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5432
PGVECTOR_DB=clinical_platform
PGVECTOR_USER=clinical
PGVECTOR_PASSWORD=<choose-a-strong-local-password>

# ── Gold table (P7+) ─────────────────────────────────────────────────────────
GOLD_CHUNKS_TABLE=clinical_platform.gold.rag_chunks
